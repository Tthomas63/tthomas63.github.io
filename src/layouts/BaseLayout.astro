---
import 'bulma/css/bulma.min.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Tyler Thomas — software engineering, infrastructure, developer tooling, and selected technical work.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f0eee7" />
    <title>{title} | tthomas63</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-width site-nav">
        <a href="/" class="wordmark" aria-label="tthomas homepage">tthomas63<span>/</span></a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/#work">Work</a>
          <a href="/notes/">Notes</a>
          <a href="/#expertise">Expertise</a>
          <a href="/#about">About</a>
          <a href="https://github.com/tthomas63" target="_blank" rel="noopener noreferrer" class="nav-github">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="site-width footer-inner">
        <span>© {new Date().getFullYear()} Tyler Thomas</span>
        <span class="footer-mark">ENGINEERED, NOT OVERCOMPLICATED.</span>
      </div>
    </footer>
  </body>
</html>
